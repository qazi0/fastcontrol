<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.fastcontrol</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BIN__</string>
    <string>-no-qr</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HOME__/.fastcontrol/relay.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.fastcontrol/relay.log</string>
</dict>
</plist>

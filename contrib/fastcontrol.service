[Unit]
Description=fastcontrol Relay
After=network-online.target

[Service]
Type=simple
ExecStart="%h/.fastcontrol/fastcontrol" -no-qr -tls
WorkingDirectory=%h
Restart=on-failure
RestartSec=3
UMask=0077
StandardOutput=append:%h/.fastcontrol/relay.log
StandardError=append:%h/.fastcontrol/relay.log

[Install]
WantedBy=default.target
